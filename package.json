{
  "name": "nexus-farmer",
  "productName": "Nexus Farmer",
  "version": "1.0.0",
  "description": "Nexus Farmer, de Nexus Dev: gestor de granjas de teléfonos Android con automatizaciones por nodos (ADB USB, OTG directo y Wi-Fi)",
  "main": "src/main/main.js",
  "type": "module",
  "author": "Nexus Dev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "licencias": "node tools/licencias.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/android-bin": "^2.1.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "drawflow": "^0.0.60",
    "usb": "^2.16.0"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nexusdev.nexusfarmer",
    "productName": "Nexus Farmer",
    "copyright": "Copyright © 2026 Nexus Dev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/vendor/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/usb/**",
      "build/vendor/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Nexus Farmer",
      "artifactName": "NexusFarmer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NexusFarmer-Portable-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  }
}
